#!/bin/sh
# OKF guard, two halves:
#   1. staleness -- source changed without its OKF file being touched;
#   2. content   -- what the OKF files say must hold against the code
#      (imports, names, paths, links, generated spans). Run
#      `python scripts/okf_check.py --write` to refresh generated spans.
# Bypass with: git commit --no-verify
root="$(git rev-parse --show-toplevel)"
python "$root/scripts/okf_staleness_check.py" --mode=git || exit 1
python "$root/scripts/okf_check.py" || exit 1
