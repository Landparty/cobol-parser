//INVUPD01 JOB (ACCT1234,'INVENTORY'),'S DION',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,REGION=0M
//*
//* NIGHTLY INVENTORY MASTER UPDATE -- EDIT, THEN APPLY
//*
// SET HLQ=PROD.INV
// SET CYCLE=D
//JOBLIB   DD DSN=PROD.LOADLIB,DISP=SHR
//         DD DSN=SYS1.COB2LIB,DISP=SHR
//*
//STEP010  EXEC PGM=INVEDIT,PARM='EDIT,STRICT'
//STEPLIB  DD DSN=PROD.LOADLIB,DISP=SHR
//INVTRAN  DD DSN=&HLQ..TRANS(0),DISP=SHR
//INVGOOD  DD DSN=&HLQ..TRANS.GOOD,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=27800)
//INVBAD   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD DUMMY
//SYSIN    DD *
  EDIT MODE=STRICT
  REJECT WHEN QTY < 0
/*
//*
//STEP020  EXEC PGM=INVUPDT,COND=(4,LT,STEP010)
//INVFILE  DD DSN=&HLQ..MASTER,DISP=SHR
//INVUPD   DD DSN=&HLQ..TRANS.GOOD,DISP=(OLD,DELETE,DELETE)
//RPTFILE  DD DSN=&HLQ..REPORT.&CYCLE,DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5)),DCB=(RECFM=FBA,LRECL=133)
//SYSPRINT DD SYSOUT=*
//
