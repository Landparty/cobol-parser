*  CUSTOMER DATABASE
         DBD   NAME=CUSTDB,ACCESS=(HIDAM,VSAM)
         DATASET DD1=CUSTDD,DEVICE=3390,SIZE=4096
         SEGM  NAME=CUSTOMER,PARENT=0,BYTES=120,POINTER=TWINBWD
         FIELD NAME=(CUSTNO,SEQ,U),BYTES=8,START=1,TYPE=C
         FIELD NAME=CUSTNAME,BYTES=30,START=9,TYPE=C
         LCHILD NAME=(INDEX,CUSTIX),POINTER=INDX
         XDFLD NAME=XNAME,SRCH=CUSTNAME
         SEGM  NAME=ACCOUNT,PARENT=((CUSTOMER,SNGL)),BYTES=(80,40)
         FIELD NAME=(ACCTNO,SEQ,M),BYTES=10,START=1,TYPE=P
         SEGM  NAME=TXN,PARENT=ACCOUNT,BYTES=60
         DBDGEN
         FINISH
         END
