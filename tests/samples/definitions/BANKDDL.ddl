-- BANK APPLICATION DB2 OBJECTS
CREATE DATABASE BANKDB;
CREATE TABLESPACE ACCTTS IN BANKDB USING STOGROUP SYSDEFLT;
CREATE TABLE BANK.ACCOUNT
  ( ACCT_NO      DECIMAL(10, 0)   NOT NULL
  , CUST_ID      CHAR(8)          NOT NULL
  , ACCT_TYPE    CHAR(1)          NOT NULL WITH DEFAULT 'C'
  , BALANCE      DECIMAL(15, 2)   NOT NULL WITH DEFAULT
  , OPENED_TS    TIMESTAMP        DEFAULT CURRENT TIMESTAMP
  , NOTES        VARCHAR(200)     FOR BIT DATA
  , CONSTRAINT ACCT_PK PRIMARY KEY (ACCT_NO)
  , CONSTRAINT ACCT_CUST_FK FOREIGN KEY (CUST_ID)
      REFERENCES BANK.CUSTOMER (CUST_ID) ON DELETE RESTRICT
  , CHECK (ACCT_TYPE IN ('C', 'S'))
  )
  IN BANKDB.ACCTTS;
/* customers */
CREATE TABLE BANK.CUSTOMER (
  CUST_ID   CHAR(8) NOT NULL PRIMARY KEY,
  NAME      VARCHAR(40) NOT NULL,
  BRANCH_ID SMALLINT REFERENCES BANK.BRANCH (BRANCH_ID),
  UNIQUE (NAME)
);
CREATE TABLE BANK.ACCT_HIST LIKE BANK.ACCOUNT;
CREATE UNIQUE INDEX BANK.ACCTIX1 ON BANK.ACCOUNT (ACCT_NO ASC) CLUSTER;
CREATE INDEX BANK.ACCTIX2 ON BANK.ACCOUNT (CUST_ID, ACCT_TYPE DESC);
CREATE VIEW BANK.V_CUST_ACCT (CUST_ID, NAME, ACCT_NO) AS
  SELECT C.CUST_ID, C.NAME, A.ACCT_NO
    FROM BANK.CUSTOMER C
    JOIN BANK.ACCOUNT A ON A.CUST_ID = C.CUST_ID
   WHERE A.BALANCE > 0;
CREATE ALIAS ACCOUNT FOR BANK.ACCOUNT;
ALTER TABLE BANK.ACCOUNT ADD COLUMN CLOSED_DT DATE;
ALTER TABLE BANK.MISSING ADD COLUMN X CHAR(1);
COMMENT ON TABLE BANK.ACCOUNT IS 'One row per customer account';
COMMENT ON COLUMN BANK.ACCOUNT.BALANCE IS 'Ledger balance, in cents';
LABEL ON BANK.CUSTOMER (CUST_ID IS 'Customer', NAME IS 'Customer''s name');
GRANT SELECT ON BANK.ACCOUNT TO PUBLIC;
--#SET TERMINATOR #
CREATE TABLE BANK.BRANCH (BRANCH_ID SMALLINT NOT NULL, CITY CHAR(20))#
