* CICS RESOURCE DEFINITIONS FOR THE BANK APPLICATION (DFHCSDUP INPUT)
DEFINE TRANSACTION(ACCT) GROUP(BANKGRP)
       PROGRAM(ACCTINQ) TWASIZE(0) PROFILE(DFHCICST)
       DESCRIPTION(Account inquiry from the
       branch terminals)
DEFINE TRANSACTION(ACUP) GROUP(BANKGRP) PROGRAM(ACCTUPD)
DEF TRANS(PAYM) GROUP(BANKGRP) PROG(PAYMENT) REMOTESYSTEM(CICB)
DEFINE PROGRAM(ACCTINQ) GROUP(BANKGRP) LANGUAGE(COBOL) EXECKEY(USER)
DEFINE PROGRAM(ACCTUPD) GROUP(BANKGRP) LANGUAGE(COBOL)
DEFINE MAPSET(ACCTSET) GROUP(BANKGRP)
DEFINE FILE(ACCTFIL) GROUP(BANKGRP) DSNAME(PROD.BANK.ACCOUNT.KSDS)
       RECORDFORMAT(F) ADD(YES) BROWSE(YES) DELETE(NO) READ(YES) UPDATE(YES)
DEFINE DB2ENTRY(BANKENT) GROUP(BANKGRP) PLAN(BANKPLN)
DEFINE DB2TRAN(ACUPTRN) GROUP(BANKGRP) ENTRY(BANKENT) TRANSID(ACUP)
ALTER TRANSACTION(ACUP) GROUP(BANKGRP) DESCRIPTION(Account update)
ALTER TRANSACTION(NONE) GROUP(BANKGRP) PROFILE(X)
DEFINE GROUP(ORPHAN)
ADD GROUP(BANKGRP) LIST(BANKLIST)
