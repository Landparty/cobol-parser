*  PSB FOR THE CUSTOMER UPDATE PROGRAM
IOPCB    PCB   TYPE=TP,MODIFY=YES
         PCB   TYPE=DB,DBDNAME=CUSTDB,PROCOPT=A,KEYLEN=26,PCBNAME=CUSTPCB
         SENSEG NAME=CUSTOMER,PARENT=0,PROCOPT=G
         SENSEG NAME=ACCOUNT,PARENT=CUSTOMER
         PCB   TYPE=GSAM,DBDNAME=EXTRACT,PROCOPT=LS
         PSBGEN LANG=COBOL,PSBNAME=CUSTUPD,CMPAT=YES
         END
