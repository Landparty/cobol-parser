* ACCOUNT INQUIRY SCREENS
ACCTSET  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,TIOAPFX=YES,       X
               CTRL=(FREEKB,FRSET),STORAGE=AUTO
ACCTMNU  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=8,ATTRB=(ASKIP,BRT),INITIAL='ACCTMNU'
         DFHMDF POS=(1,30),LENGTH=20,ATTRB=(ASKIP,BRT),                 X
               INITIAL='ACCOUNT INQUIRY'
         DFHMDF POS=(4,5),LENGTH=12,ATTRB=ASKIP,INITIAL='ACCOUNT NO:'
ACCTNO   DFHMDF POS=(4,18),LENGTH=10,ATTRB=(UNPROT,NUM,IC),PICIN='9(10)'
         DFHMDF POS=(4,29),LENGTH=1,ATTRB=PROT
CUSTNM   DFHMDF POS=(6,18),LENGTH=30,ATTRB=(PROT,NORM)
BALANCE  DFHMDF POS=(8,18),LENGTH=15,ATTRB=PROT,PICOUT='Z,ZZZ,ZZ9.99-'
         DFHMDF POS=(23,1),LENGTH=40,ATTRB=ASKIP,                      X
               INITIAL='PF3=EXIT  ENTER=INQUIRE  CUSTOMER''S DATA'
MSG      DFHMDF POS=(24,1),LENGTH=79,ATTRB=(ASKIP,BRT),COLOR=RED
ACCTDTL  DFHMDI SIZE=(24,80)
         DFHMDF POS=0,LENGTH=14,INITIAL='ACCOUNT DETAIL'
ADDR1    DFHMDF POS=(5,10),LENGTH=40,ATTRB=UNPROT
         DFHMSD TYPE=FINAL
         END
