 /* PAYROLL DRIVER: READS EMPLOYEES, CALLS THE COBOL CALCULATION */
 PAYDRV: PROC OPTIONS(MAIN);
   %INCLUDE PAYREC;
   DCL PAYCALC ENTRY EXTERNAL;
   DCL LOGIT ENTRY EXTERNAL('PAYLOG');
   DCL EMP_COUNT FIXED BIN(31) INIT(0);
   CALL PAYCALC(EMP_REC, EMP_COUNT);
   CALL LOGIT(EMP_COUNT);
   CALL DATERTN(RUN_DATE);
   CALL SUMMARY;
 SUMMARY: PROC;
   PUT SKIP LIST('EMPLOYEES', EMP_COUNT);
 END SUMMARY;
 END PAYDRV;
