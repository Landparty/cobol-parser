//FEEJOB   JOB (ACCT),'FEE RUN',CLASS=A
//STEP010  EXEC PGM=WRITER
//INFILE   DD  DSN=PROD.TRAN.DAILY(0),DISP=SHR
//OUTFILE  DD  DSN=&&FEES,DISP=(NEW,PASS)
//STEP020  EXEC PGM=SORT
//SORTIN   DD  DSN=&&FEES,DISP=(OLD,PASS)
//SORTOUT  DD  DSN=PROD.FEE.SUMMARY(+1),DISP=(NEW,CATLG)
//SYSIN    DD  *
  SORT FIELDS=(1,10,CH,A)
  SUM FIELDS=(20,7,ZD)
/*
//STEP030  EXEC PGM=READER
//FEEIN    DD  DSN=PROD.FEE.SUMMARY(+1),DISP=SHR
//MASTER   DD  DSN=PROD.ACCT.MASTER,DISP=SHR
