//ORDNIGHT JOB (ORD001),'ORDER NIGHTLY',CLASS=A,MSGCLASS=X
//         JCLLIB ORDER=(SHOP.ORD.PROCLIB)
//*
//*  NIGHTLY ORDER CYCLE: EDIT -> SORT -> POST -> REPORT
//*
//STEP010  EXEC ORDEDITP,ENV=PROD
//STEP020  EXEC PGM=SORT,COND=(4,LT)
//SORTIN   DD DSN=PROD.ORD.GOOD,DISP=(OLD,DELETE,KEEP)
//SORTOUT  DD DSN=PROD.ORD.GOOD.SORTED,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(20,10),RLSE)
//SYSOUT   DD SYSOUT=*
//SYSIN    DD *
  SORT FIELDS=(11,8,CH,A,1,10,CH,A)
