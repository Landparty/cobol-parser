{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobolparser.dev/schemas/io-coverage-artifact.json",
  "title": "IO Coverage Artifact",
  "description": "Machine-readable coverage report for COBOL IO statement variations.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "dialect_profile",
    "variations",
    "baseline_metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "dialect_profile": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseline_metrics": {
      "type": "object",
      "required": [
        "pytest_duration_seconds",
        "performance_suite_duration_seconds",
        "max_memory_mb",
        "coverage_percent"
      ],
      "properties": {
        "pytest_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "performance_suite_duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "max_memory_mb": {
          "type": "number",
          "minimum": 0
        },
        "coverage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "variations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/variation_entry"
      }
    }
  },
  "definitions": {
    "variation_entry": {
      "type": "object",
      "required": [
        "variation_id",
        "verb",
        "status",
        "file_organization",
        "qualifiers",
        "tests",
        "last_run",
        "stats"
      ],
      "properties": {
        "variation_id": {
          "type": "string",
          "pattern": "^[A-Z0-9\-]+$"
        },
        "verb": {
          "type": "string",
          "enum": [
            "OPEN",
            "CLOSE",
            "READ",
            "WRITE",
            "REWRITE",
            "DELETE",
            "START",
            "ACCEPT",
            "DISPLAY",
            "UNLOCK"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["covered", "gap", "missing"]
        },
        "file_organization": {
          "type": "string",
          "enum": ["SEQUENTIAL", "INDEXED", "RELATIVE", "VSAM", "N/A"]
        },
        "access_mode": {
          "type": ["string", "null"],
          "enum": [
            "INPUT",
            "OUTPUT",
            "I-O",
            "EXTEND",
            "SEQUENTIAL",
            "RANDOM",
            "DYNAMIC",
            "N/A",
            null
          ]
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires_fd_clauses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/test_reference"
          }
        },
        "last_run": {
          "type": "string",
          "format": "date-time"
        },
        "stats": {
          "type": "object",
          "required": ["passed", "failed", "duration_seconds"],
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "duration_seconds": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/diagnostic"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri-reference"
          }
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "test_reference": {
      "type": "object",
      "required": [
        "nodeid",
        "type"
      ],
      "properties": {
        "nodeid": {
          "type": "string",
          "description": "Pytest node id, e.g., tests/unit/io/test_read.py::TestRead::test_read_next_with_lock"
        },
        "type": {
          "type": "string",
          "enum": ["unit", "contract", "integration"]
        },
        "fixture_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "message", "line", "column"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "recovery_hint": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
